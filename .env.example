# =========================
# NIX - PROVIDERS
# =========================

OPENROUTER_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
SAMBANOVA_API_KEY=
GEMINI_API_KEY=
COHERE_API_KEY=
HF_TOKEN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# =========================
# MODELS
# =========================

OPENROUTER_MODEL=openrouter/free
GROQ_MODEL=openai/gpt-oss-20b
MISTRAL_MODEL=mistral-small-latest
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct
GEMINI_MODEL=gemini-3.6-flash
COHERE_MODEL=command-a-plus-05-2026
HF_MODEL=openai/gpt-oss-20b:fastest
CLOUDFLARE_MODEL=@cf/openai/gpt-oss-20b

# OpenRouter server-side web search.
# true = available for requests where Nix detects web intent.
# false = disabled to avoid search charges.
OPENROUTER_WEB_SEARCH=false

# =========================
# VOICE
# =========================

# Optional saved Mistral voice ID.
# If empty, Nix falls back to local espeak-ng TTS.
MISTRAL_VOICE_ID=

VOICE_RECORD_SECONDS=6
