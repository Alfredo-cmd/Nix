# =========================
# NIX - PROVIDERS
# =========================

OPENROUTER_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
SAMBANOVA_API_KEY=
GEMINI_API_KEY=
COHERE_API_KEY=
HF_TOKEN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# =========================
# MODELS
# =========================

OPENROUTER_MODEL=openrouter/free
GROQ_MODEL=openai/gpt-oss-20b
GROQ_STT_MODEL=whisper-large-v3
MISTRAL_MODEL=mistral-small-latest
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct
GEMINI_MODEL=gemini-3.6-flash
COHERE_MODEL=command-a-plus-05-2026
HF_MODEL=openai/gpt-oss-20b:fastest
CLOUDFLARE_MODEL=@cf/openai/gpt-oss-20b

# OpenRouter server-side web search.
OPENROUTER_WEB_SEARCH=false

# =========================
# VOICE
# =========================

# Gravação temporária antes do STT.
VOICE_RECORD_SECONDS=6

# Qwen3-TTS local.
VOICE_TTS_ENABLED=true
VOICE_TTS_FALLBACK=true
QWEN_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-Base
QWEN_TTS_DEVICE=cpu
QWEN_TTS_LANGUAGE=Portuguese
QWEN_TTS_REFERENCE_AUDIO=voice/sample.wav
QWEN_TTS_REFERENCE_TEXT=Olá. Eu sou a Nix, sua assistente pessoal.

# ID antigo de voz da Mistral, mantido apenas para compatibilidade.
MISTRAL_VOICE_ID=
